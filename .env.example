# Copy this file to .env and fill in your connection string.
# .env is in .gitignore - never commit real credentials.

# Use your own PostgreSQL connection string here.
# Local Postgres:
DATABASE_URL=postgresql://postgres@localhost:5432/itus_txn

# Hosted Postgres (Neon, Supabase, Render, Aiven...) usually needs SSL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
